<UserControl x:Class="ProyectoAutomatas.Views.JuegoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProyectoAutomatas.Views"
             xmlns:h="clr-namespace:ProyectoAutomatas.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#061E29" FontFamily="Consolas">
    <UserControl.Resources>
        <h:TiempoToStringConverter x:Key="converter"></h:TiempoToStringConverter>
        <Style TargetType="Button" x:Key="BotonRojo">
            <Setter Property="Opacity" Value="0.5"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
            CornerRadius="140,20,20,20"
            BorderBrush="#111"
            BorderThickness="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorActivo}" Value="R">
                    <Setter Property="Opacity" Value="1"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding MostrandoSecuencia}" Value="true">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGameOver}" Value="true">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="BotonVerde">
            <Setter Property="Opacity" Value="0.5"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
    CornerRadius="140,20,20,20"
    BorderBrush="#111"
    BorderThickness="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorActivo}" Value="G">
                    <Setter Property="Opacity" Value="1"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding MostrandoSecuencia}" Value="true">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGameOver}" Value="true">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="BotonAzul">
            <Setter Property="Opacity" Value="0.5"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
    CornerRadius="140,20,20,20"
    BorderBrush="#111"
    BorderThickness="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorActivo}" Value="B">
                    <Setter Property="Opacity" Value="1"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding MostrandoSecuencia}" Value="true">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGameOver}" Value="true">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="BotonAmarillo">
            <Setter Property="Opacity" Value="0.5"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
    CornerRadius="140,20,20,20"
    BorderBrush="#111"
    BorderThickness="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ColorActivo}" Value="Y">
                    <Setter Property="Opacity" Value="1"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding MostrandoSecuencia}" Value="true">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGameOver}" Value="true">
                    <Setter Property="IsEnabled" Value="False"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>


        <UniformGrid Columns="3" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Nivel: " Foreground="#5F9598" FontSize="16"></TextBlock>
                <TextBlock Text="{Binding Nivel}" Foreground="#F3F4F4" FontWeight="Bold" FontSize="18"></TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Ronda: " Foreground="#5F9598" FontSize="16"></TextBlock>
                <TextBlock Text="{Binding Ronda}" Foreground="#F3F4F4" FontWeight="Bold" FontSize="18"></TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Tiempo: " Foreground="#5F9598" FontSize="16"></TextBlock>
                <TextBlock Text="{Binding TiempoRestante, Converter={StaticResource ResourceKey=converter}}" Foreground="#F3F4F4" FontWeight="Bold" FontSize="18"></TextBlock>
            </StackPanel>
        </UniformGrid>



        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Height="320">
            <Ellipse Fill="#1A1A1B" Stroke="#333" StrokeThickness="2"></Ellipse>

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Button x:Name="BtnVerde" Grid.Row="0" Grid.Column="0"
                Background="#22C55E"
                Margin="5" Style="{StaticResource BotonVerde}"
                Command="{Binding AgregarSecuenciaCommand}"
                CommandParameter="G"></Button>

                <Button x:Name="BtnRojo" Grid.Row="0" Grid.Column="1"
                Background="#EF4444"
                Margin="5" Style="{StaticResource BotonRojo}"
                Command="{Binding AgregarSecuenciaCommand}"
                CommandParameter="R">
                    <Button.RenderTransform>
                        <RotateTransform Angle="90" CenterX="70" CenterY="70"></RotateTransform>
                    </Button.RenderTransform>
                </Button>

                <Button x:Name="BtnAmarillo" Grid.Row="1" Grid.Column="0"
                Background="#F59E0B"
                Margin="5" Style="{StaticResource BotonAmarillo}"
                Command="{Binding AgregarSecuenciaCommand}"
                CommandParameter="Y">
                    <Button.RenderTransform>
                        <RotateTransform Angle="-90" CenterX="70" CenterY="70"></RotateTransform>
                    </Button.RenderTransform>
                </Button>

                <Button x:Name="BtnAzul" Grid.Row="1" Grid.Column="1"
                Background="#3B82F6"
                Margin="5" Style="{StaticResource BotonAzul}"
                Command="{Binding AgregarSecuenciaCommand}"
                CommandParameter="B">
                    <Button.RenderTransform>
                        <RotateTransform Angle="180" CenterX="70" CenterY="70"></RotateTransform>
                    </Button.RenderTransform>
                </Button>
            </Grid>

            <Ellipse Width="100" Height="100" Fill="#1A1A1B" Stroke="#333" StrokeThickness="4"></Ellipse>
            <TextBlock Text="SIMÓN" Foreground="White" FontWeight="Black"
               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18"></TextBlock>
        </Grid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,20,0,0">

        </StackPanel>
    </Grid>
</UserControl>
