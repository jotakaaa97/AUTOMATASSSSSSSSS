<UserControl x:Class="ProyectoAutomatas.Views.MarcadorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProyectoAutomatas.Views"
             xmlns:h="clr-namespace:ProyectoAutomatas.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#061E29" FontFamily="Consolas">
    <UserControl.Resources>
        <h:TiempoToStringConverter x:Key="converter"></h:TiempoToStringConverter>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock Text="Puntajes" 
           FontSize="22" 
           FontWeight="Bold" 
           Foreground="#F3F4F4" 
           Margin="6,0,6,15"></TextBlock>

        <DataGrid Grid.Row="1"
          ItemsSource="{Binding Partidas}"
          AutoGenerateColumns="False" 
          HeadersVisibility="Column"
          CanUserAddRows="False" 
          Background="#061E29" 
          BorderThickness="1"
          BorderBrush="#1D546D"
          RowBackground="#061E29" 
          AlternatingRowBackground="#0A2633"
          Foreground="#F3F4F4"
          GridLinesVisibility="None"
          RowHeight="38">

            <DataGrid.Resources>

                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#1D546D"></Setter>
                    <Setter Property="Foreground" Value="#F3F4F4"></Setter>
                    <Setter Property="Padding" Value="12,8"></Setter>
                    <Setter Property="FontWeight" Value="Bold"></Setter>
                    <Setter Property="BorderThickness" Value="0,0,0,2"></Setter>
                    <Setter Property="BorderBrush" Value="#5F9598"></Setter>
                </Style>

                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Padding" Value="10,0"></Setter>
                    <Setter Property="BorderThickness" Value="0"></Setter>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"></Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridCell}">
                                <Border Background="{TemplateBinding Background}" Padding="10,0">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      ></ContentPresenter>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#5F9598"></Setter>
                            <Setter Property="Foreground" Value="#061E29"></Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Jugador"
                                Binding="{Binding Jugador}"
                                Width="*" 
                                IsReadOnly="True"></DataGridTextColumn>

                <DataGridTextColumn Header="Ronda"
                                Binding="{Binding Ronda}"
                                Width="80" 
                                IsReadOnly="True"></DataGridTextColumn>

                <DataGridTextColumn Header="Nivel"
                                Binding="{Binding Nivel}"
                                Width="80" 
                                IsReadOnly="True"></DataGridTextColumn>

                <DataGridTextColumn Header="Tiempo"
                                Binding="{Binding Tiempo, Converter={StaticResource converter}}"
                                Width="100" 
                                IsReadOnly="True"></DataGridTextColumn>

            </DataGrid.Columns>

        </DataGrid>

        <Button Content="REGRESAR"
        Width="160"
        Height="40"
        Margin="610,3,0,12"
        HorizontalAlignment="Left"
       Background="#1D546D" Foreground="White" 
FontWeight="Bold" BorderBrush="#5F9598" BorderThickness="1" Command="{Binding VerResultadosCommand}"></Button>

    </Grid>
</UserControl>
