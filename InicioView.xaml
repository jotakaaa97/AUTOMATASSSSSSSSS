<UserControl x:Class="ProyectoAutomatas.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProyectoAutomatas.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#061E29" FontFamily="Consolas">
     <Grid>

        <Border CornerRadius="16"
    Background="#1D546D"
    Padding="32"
    Width="480"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    BorderBrush="#5F9598"
    BorderThickness="1">

            <StackPanel>


                <TextBlock Text="Simon Dice" 
               FontSize="34"
               FontWeight="Black"
               Foreground="#F3F4F4"
               HorizontalAlignment="Center"
               Margin="0,0,0,8" FontFamily="Bahnschrift"></TextBlock>


                <TextBlock Text="Ingresa tu nombre para empezar"
               Foreground="#5F9598"
               FontSize="15"
               HorizontalAlignment="Center"
               Margin="0,0,0,24"></TextBlock>


                <TextBox Width="320"
             Height="45"
             FontSize="18"
             VerticalContentAlignment="Center"
             Padding="12,0"
             Margin="0,0,0,10"
             BorderBrush="#F3F4F4"
             BorderThickness="0,0,0,2"
             Background="#061E29"
             Foreground="#F3F4F4"
             CaretBrush="#F3F4F4"
             Text="{Binding NombreJugador}"></TextBox>

                <TextBlock Text="{Binding Error}"
               Foreground="Red"
               FontSize="12"
               HorizontalAlignment="Center"
               Margin="0,0,0,10"></TextBlock>


                <Button Content="INICIAR JUEGO"
            Width="200"
            Height="52"
            Background="#F3F4F4"
            Foreground="#061E29"
            FontWeight="Bold"
            BorderThickness="0"
            Cursor="Hand"
            Command="{Binding IniciarJuegoCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"></Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

        </Border>

    </Grid>
</UserControl>
